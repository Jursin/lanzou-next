{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蓝奏云盘",
  "mainBinaryName": "lanzou-next",
  "version": "0.1.0",
  "identifier": "com.lanzou.next",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "蓝奏云盘",
        "width": 1260,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jursin",
    "copyright": "Copyright © 2026 Jursin. All rights reserved.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "template": "nsis/installer.nsi"
      }
    }
  }
}