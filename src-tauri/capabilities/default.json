{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-inner-size",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    "store:default",
    "log:default",
    "clipboard-manager:allow-read-text",
    "allow-config-get",
    "allow-config-set",
    "allow-config-reset",
    "allow-config-clear",
    "allow-log-get-file",
    "allow-log-clear",
    "allow-check-for-update",
    "allow-cancel-download",
    "allow-download-and-install",
    "allow-lanzou-ls",
    "allow-lanzou-profile",
    "allow-lanzou-share-info",
    "allow-lanzou-share-folder",
    "allow-lanzou-download",
    "allow-lanzou-download-by-id",
    "allow-lanzou-cancel-transfer",
    "allow-lanzou-upload",
    "allow-lanzou-upload-precheck",
    "allow-lanzou-merge-download",
    "allow-lanzou-check-path",
    "allow-lanzou-delete-local",
    "allow-lanzou-delete-local-dir",
    "allow-lanzou-login",
    "allow-lanzou-logout",
    "allow-lanzou-mkdir",
    "allow-lanzou-rm-file",
    "allow-lanzou-rm-folder",
    "allow-lanzou-rename-file",
    "allow-lanzou-rename-folder",
    "allow-lanzou-move",
    "allow-lanzou-recycle-list",
    "allow-lanzou-recycle-files",
    "allow-lanzou-recycle-action",
    "allow-lanzou-set-file-access",
    "allow-lanzou-set-folder-access",
    "allow-lanzou-file-description",
    "allow-lanzou-set-file-description",
    "allow-lanzou-file-detail",
    "allow-lanzou-folder-detail"
  ]
}
